
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Product {
  id              String   @id
  name            String
  category        String
  price           Decimal  @db.Decimal(10, 2)
  size            String
  image           String
  description     String
  cardDescription String   @map("card_description")
  howToUse        String?  @map("how_to_use")
  caution         String?
  badge           String?
  originalPrice   Decimal? @map("original_price") @db.Decimal(10, 2)
  discountPercent Int?     @map("discount_percent")
  discountLabel   String?  @map("discount_label")
  rating          Decimal? @db.Decimal(3, 2)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("products")
}

model Order {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  status          String   @default("awaiting_payment")
  paymentMethod   String   @default("momo") @map("payment_method")
  items           Json     @db.JsonB
  subtotal        Decimal  @db.Decimal(10, 2)
  shipping        Decimal  @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  customerName    String   @map("customer_name")
  customerEmail   String?  @map("customer_email")
  phone           String
  shippingAddress String   @map("shipping_address")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("orders")
}

model CustomerProfile {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String?           @unique
  fullName     String?           @map("full_name")
  email        String?           @unique
  phone        String?           @unique
  passwordHash String            @map("password_hash")
  cart         Json              @default("[]") @db.JsonB
  wishlist     Json              @default("[]") @db.JsonB
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions     CustomerSession[]

  @@map("customer_profiles")
}

model CustomerVerification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String    @unique
  destination String
  channel    String
  codeHash   String?   @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("customer_verifications")
}

model CustomerSession {
  tokenHash String          @id @map("token_hash")
  userId    String          @map("user_id") @db.Uuid
  expiresAt DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user      CustomerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename  String
  mimeType  String   @map("mime_type")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("product_images")
}

model HomepageSettings {
  id              String   @id @default("homepage")
  heroEditorial   String   @map("hero_editorial")
  heroLookbook    String   @map("hero_lookbook")
  heroDetail      String   @map("hero_detail")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("homepage_settings")
}

model AdminCredential {
  id             String   @id @default("admin")
  passwordHash   String   @map("password_hash")
  sessionVersion Int      @default(0) @map("session_version")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_credentials")
}
